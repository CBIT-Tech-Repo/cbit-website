---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you asked for is not on the CBIT Venture Builder website." section="not-found">
  <section class="hero hero--text" aria-labelledby="page-title">
    <div class="wrap hero__inner">
      <div class="hero__body">
        <h1 id="page-title">Page not found</h1>
        <p class="lead">The page may have moved while the new website is being built.</p>
        <p><a class="more-link" href="/">Go to the home page</a> <a class="more-link" href="mailto:cbit@ntu.ac.uk">Email cbit@ntu.ac.uk</a></p>
      </div>
    </div>
  </section>
</Base>
